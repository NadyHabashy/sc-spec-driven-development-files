  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@picocss/pico": "^2.1.1",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "private": true
}
